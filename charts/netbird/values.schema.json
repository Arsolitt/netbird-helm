        },
        "envFromSecret": {
          "$ref": "#/definitions/envFromSecret"
        }
      }
    },
    "serverConfig": {
      "type": "object",
      "description": "Unified server config (rendered into config.yaml). Pass-through: only the keys whose type decides whether the server starts are typed.",
      "additionalProperties": true,
      "properties": {
        "listenAddress": {
          "type": "string"
        },
        "exposedAddress": {
          "type": "string"
        },
        "stunPorts": {
