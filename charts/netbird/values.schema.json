{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chart values for the NetBird Helm chart",
  "description": "Schema for charts/netbird. Validated on every Helm command. Keys the templates interpolate verbatim accept both the integer and the numeric-string form; pass-through configuration (probes, resources, security contexts, server.config) stays free-form; the keys whose type decides whether an application starts (booleans, ports, service/strategy types, pull policies) are strict.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "management": {
      "$ref": "#/definitions/management"
    },
    "signal": {
      "$ref": "#/definitions/signal"
    },
    "relay": {
      "$ref": "#/definitions/relay"
    },
    "server": {
      "$ref": "#/definitions/server"
    },
    "dashboard": {
      "$ref": "#/definitions/dashboard"
    },
    "extraManifests": {
      "description": "Extra manifests rendered with tpl; a map of manifests or a list.",
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "$ref": "#/definitions/serviceMonitor"
        }
      }
    }
  },
  "definitions": {
    "port": {
      "description": "Port. Accepts an integer or a numeric string: the templates interpolate the value without quoting, so both render as a YAML integer.",
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^[0-9]+$"
    },
    "replicaCount": {
      "description": "Replica count; interpolated verbatim, so a numeric string also renders as an integer.",
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^[0-9]+$"
    },
    "annotations": {
      "description": "Annotations merged into metadata.annotations. Values must be scalars.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "labels": {
      "description": "Extra labels merged into metadata.labels. Values must be scalars.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "env": {
      "description": "Environment variables rendered as literal `value:` pairs. Scalars only; use envRaw for valueFrom-style entries.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "envRaw": {
      "description": "Raw env entries rendered with toYaml; full Kubernetes EnvVar objects.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "envFromSecret": {
      "description": "Map of ENV_VAR to `secretName/secretKey`; rendered as secretKeyRef valueFrom entries.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "string"
        ]
      }
    },
    "image": {
      "type": [
        "object",
        "null"
      ],
      "description": "Container image; the tag defaults to the chart appVersion when empty.",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "description": "Kubernetes imagePullPolicy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": [
            "string",
            "number",
            "null"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "strategy": {
      "type": [
        "object",
        "null"
      ],
      "description": "Kubernetes Deployment strategy. Omitted (or null) for a relay instance, the template renders `type: Recreate`.",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSurge": {
              "type": [
                "string",
                "number"
              ]
            },
            "maxUnavailable": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "probe": {
      "description": "Kubernetes Probe object rendered with toYaml.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "nodeSelector": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "podSecurityContext": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "securityContext": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "resources": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "lifecycle": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "volumeMounts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "volumes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "initContainers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "externalIPs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "metrics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "persistentVolume": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "accessModes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": [
            "string",
            "number"
          ]
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "existingPVName": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        }
      }
    },
    "ingress": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "hosts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "pathType"
                  ]
                }
              }
            },
            "required": [
              "host",
              "paths"
            ]
          }
        },
        "tls": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object"
          }
        }
      }
    },
    "podCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": {
          "type": [
