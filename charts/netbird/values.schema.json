        },
        "tls": {
          "type": "object",
          "description": "TLS settings; a quoted boolean here renders as a string in config.yaml and stops the server at startup.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "certFile": {
              "type": "string"
            },
            "keyFile": {
              "type": "string"
            },
            "letsencrypt": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "dataDir": {
                  "type": "string"
                },
                "domains": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "email": {
                  "type": "string"
                },
                "awsRoute53": {
